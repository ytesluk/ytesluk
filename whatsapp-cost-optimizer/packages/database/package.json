    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@wco/config": "workspace:*",
    "@wco/domain": "workspace:*",
    "@wco/logging": "workspace:*",
    "@wco/pricing": "workspace:*",
    "@wco/policy": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0"
  }
}
