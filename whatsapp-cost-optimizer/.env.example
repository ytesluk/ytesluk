# ---------------------------------------------------------------------------
# WhatsApp Cost Optimizer (WCO) — configuração
# Copie para .env e ajuste. NUNCA faça commit do .env.
# ---------------------------------------------------------------------------

# development | production
APP_MODE=development
NODE_ENV=development
LOG_LEVEL=info

# Infra
DATABASE_URL=postgresql://wco:wco@localhost:5432/wco
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL que o servidor Next.js usa para falar com a API (dentro do Docker: http://api:4000)
API_INTERNAL_URL=http://localhost:4000

# Segurança
# 32 bytes em base64. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
JWT_SECRET=
# Pepper para customerHash (HMAC do telefone). Trocar invalida os hashes existentes.
HASH_PEPPER=
# development | docker | production  (ver docs/SECURITY.md)
SECRET_PROVIDER=development

# WhatsApp / Meta
# true = usa MockWhatsAppProvider (nenhuma chamada externa)
MOCK_WHATSAPP=true
META_APP_ID=
META_APP_SECRET=
# Versão da Graph API. Consulte https://developers.facebook.com/docs/graph-api/changelog/versions/
META_GRAPH_API_VERSION=v26.0
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_WEBHOOK_VERIFY_TOKEN=
# Modo manual / desenvolvimento: credenciais de UMA WABA de teste do próprio desenvolvedor.
META_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
# Embedded Signup (somente Tech Provider / Solution Partner aprovado)
META_PARTNER_TYPE=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_ADVANCED_ACCESS_CONFIRMED=false

# Otimização / custos operacionais (modelo de custo de infraestrutura do próprio SaaS)
INFRA_COST_PER_MESSAGE_PROCESSED=0.00002
INFRA_COST_PER_PROVIDER_CALL=0.00005
INFRA_CURRENCY=BRL

# Template Classification Assistant (IA opcional, desligada por padrão)
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_PROVIDER=
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_MODEL=
AI_ASSISTANT_COST_PER_CALL=0

# Mock provider: simulação de entrega
MOCK_DELIVERY_RATE=0.97
MOCK_READ_RATE=0.6
MOCK_MAX_LATENCY_MS=1500
